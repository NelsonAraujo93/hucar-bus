{
  "name": "hucar-bus",
  "version": "0.0.0",
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration development-en",
    "build": "node scripts/write-release.mjs && ng build && node scripts/copy-root-assets.mjs && node scripts/upload-sourcemaps.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:hucar-bus": "node dist/hucar-bus/server/server.mjs",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "verify:tokens": "node scripts/assert-tokens.mjs",
    "i18n:extract": "ng extract-i18n --format xlf2 --output-path src/locale",
    "images": "node scripts/generate-images.mjs && node scripts/generate-favicons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --no-watch --coverage",
    "verify:build": "node scripts/assert-localized-build.mjs",
    "smoke:dev": "node scripts/smoke-dev-server.mjs",
    "prepare": "husky"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@sentry/angular": "^10.75.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "24.x"
  }
}
