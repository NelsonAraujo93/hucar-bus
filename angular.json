{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "hucar-bus": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "hb",
      "i18n": {
        "sourceLocale": {
          "code": "es",
          "subPath": "es"
        },
        "locales": {
          "en-GB": {
            "translation": "src/locale/messages.en-GB.xlf",
            "subPath": "en"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": ["@angular/localize/init"],
            "localize": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "i18nMissingTranslation": "error",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": true,
                "vendor": false
              },
              "fileReplacements": [
                {
                  "replace": "src/app/app.routes.ts",
                  "with": "src/app/app.routes.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "**/*",
                  "input": "public-root"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "hucar-bus:build:production"
            },
            "development": {
              "buildTarget": "hucar-bus:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageReporters": ["text-summary", "lcov"],
            "coverageExclude": [
              "src/main.ts",
              "src/main.server.ts",
              "src/server.ts",
              "src/**/*.spec.ts",
              "src/app/app.config*.ts",
              "src/app/app.routes*.ts"
            ],
            "coverageThresholds": {
              "statements": 80,
              "branches": 80,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["*.ts", "api/**/*.ts", "src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
