# Environment variables, by name only. Never put a real value in this file:
# the repository is public. Real values live in Vercel (Settings > Environment
# Variables); `vercel env pull` writes them to .env.local, which is gitignored.

# --- Contact form (api/contact.ts) — Production and Preview -----------------
# Resend API key with sending access to hucarbus.com only.
RESEND_API_KEY=
# The inbox enquiries are delivered to. Kept out of the client bundle.
CONTACT_TO_EMAIL=
# Optional. The verified sender; defaults to hola@hucarbus.com.
CONTACT_FROM_EMAIL=

# --- Sentry source maps (scripts/upload-sourcemaps.mjs) — build time --------
# Missing any of the three skips the upload; the maps are deleted regardless.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
